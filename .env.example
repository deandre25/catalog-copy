# Postgres. Locally this is served by docker-compose.yml (port 5433);
# in production it is a Neon connection string.
DATABASE_URL="postgresql://catalog:catalog@localhost:5433/catalog_copy?schema=public"

# Anthropic API key. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Embeddings provider. Anthropic has no embeddings endpoint, so semantic search
# uses Voyage. https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=""
