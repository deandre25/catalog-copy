# Postgres. Locally this is served by docker-compose.yml (port 5433);
# in production it is a Neon connection string.
DATABASE_URL="postgresql://catalog:catalog@localhost:5433/catalog_copy?schema=public"

# Anthropic API key — added in stage 2. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=""

# Embeddings provider — added in stage 7. Anthropic has no embeddings endpoint,
# so the RAG stage uses a separate provider.
# VOYAGE_API_KEY=""
